{
  "name": "student-addit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:admin": "tsc -b && vite build --config vite.admin.config.ts && node scripts/prepare-admin-pages.mjs",
    "deploy:app-pages": "npm run build && wrangler pages deploy dist --project-name student-addit",
    "deploy:admin": "npm run build:admin && wrangler pages deploy dist-admin --project-name student-addit-admin",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply student-addit-db --local",
    "db:remote": "wrangler d1 migrations apply student-addit-db --remote"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.7.0",
    "wrangler": "^4.147.0"
  }
}
