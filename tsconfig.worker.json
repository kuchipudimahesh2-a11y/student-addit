{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2022", "lib": ["ES2022", "WebWorker"], "module": "ESNext", "skipLibCheck": true,
    "moduleResolution": "Bundler", "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "moduleDetection": "force", "noEmit": true, "strict": true, "types": ["@cloudflare/workers-types"],
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["worker"]
}
